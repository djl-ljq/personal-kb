{
  "name": "personal-kb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "个人工作知识库：md 为源，构建成可浏览的静态站",
  "scripts": {
    "build": "node build.mjs",
    "preview": "node build.mjs && node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const fp=p.join('..','_site',u);f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);s.end('404')}else{const ext=p.extname(fp);s.writeHead(200,{'Content-Type':ext==='.css'?'text/css':ext==='.js'?'text/javascript':ext==='.html'?'text/html; charset=utf-8':'text/plain'});s.end(d)}})}).listen(4173,()=>console.log('http://127.0.0.1:4173'))\""
  },
  "dependencies": {
    "marked": "^15.0.0"
  }
}
